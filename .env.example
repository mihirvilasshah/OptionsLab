# ---------------------------------------------------------------------------
# Optional: public site URL used for canonical links, sitemap and Open Graph.
# On Vercel this is set automatically for previews; set your production URL.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# ---------------------------------------------------------------------------
# Market data (optional). The app is fully functional WITHOUT any key: it
# falls back to a clearly labelled, model-generated simulated market.
#
# MARKET_DATA_PROVIDER:
#   simulated (default) - no network calls, fully labelled SIMULATED
#   finnhub             - live/delayed US stock quotes via Finnhub; option
#                         chains remain model-generated and labelled as such
# ---------------------------------------------------------------------------
MARKET_DATA_PROVIDER=simulated

# Server-side only. Never prefix this with NEXT_PUBLIC_.
# Free key: https://finnhub.io/register
FINNHUB_API_KEY=

# ---------------------------------------------------------------------------
# Supabase is intentionally NOT required. Progress and the paper-trading
# portfolio are stored locally in the browser. Add Supabase only if you want
# cross-device accounts; see README.
# ---------------------------------------------------------------------------
